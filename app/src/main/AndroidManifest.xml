<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================================
         Permissions
    ================================================================ -->
    <!-- Required for the foreground FilterService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required for ScreencastService (screen capture foreground service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Camera â€” required by PairingActivity to scan partner QR codes -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Microphone â€” required by AdherenceKioskActivity to record the audit video
         and by the Flutter WebSocketService for the Live Hot Mic feature -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required on Android 14+ for foreground services that capture audio -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- AlarmManager exact alarms â€” required to schedule daily adherence checks -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Full-screen intent â€” required to show AdherenceKioskActivity over lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- FCM / networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Device Admin (uninstall lock) -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required to enumerate all installed apps for the app-inventory feature -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- ================================================================
         Screen & Display
    ================================================================ -->
    <!-- SET_WALLPAPER â€” change home/lock screen wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- ================================================================
         Audio & Sound
    ================================================================ -->
    <!-- MODIFY_AUDIO_SETTINGS â€” adjust stream volumes -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ================================================================
         Network & Connectivity
    ================================================================ -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- ================================================================
         Camera & Sensors
    ================================================================ -->
    <!-- ACCESS_FINE_LOCATION â€” required for GET_LOCATION -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- FLASHLIGHT â€” needed for setTorchMode (some devices) -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- FOREGROUND_SERVICE_CAMERA and _LOCATION declared for future foreground-service uploads -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- ================================================================
         Notifications & Interruptions
    ================================================================ -->
    <!-- ACCESS_NOTIFICATION_POLICY â€” required for setInterruptionFilter (DND) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- SET_ALARM â€” fire Intent.ACTION_SET_ALARM to create alarms -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- ================================================================
         Health Connect â€” biometric vitals (HeartRate, Steps)
    ================================================================ -->
    <!-- Read permission for heart-rate data via Health Connect -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Read permission for step-count data via Health Connect -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- BLE â€” scan and connect (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE â€” legacy support (Android 11 and below) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- ================================================================
         Health Connect app discovery (Android 13 and below).
         Required so the system allows explicit queries to the Health
         Connect store app and the intent-based permission flow.
    ================================================================ -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <!-- ================================================================
         Application
    ================================================================ -->
    <application
        android:name=".TpeApplication"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tpeapp">

        <!-- Flutter engine: Dart entrypoint and initial route -->
        <meta-data android:name="io.flutter.embedding.android.NormalTheme"
            android:resource="@style/Theme.Tpeapp" />
        <meta-data android:name="io.flutter.embedding.android.SplashScreenDrawable"
            android:resource="@drawable/ic_launcher_foreground" />

        <!-- ============================================================
             Adherence Kiosk Activity â€” full-screen mandatory health check
             Launched by AdherenceAlarmReceiver via full-screen intent.
        ============================================================ -->
        <activity
            android:name=".adherence.AdherenceKioskActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- ============================================================
             Adherence Alarm Receiver â€” receives AlarmManager broadcasts
             and triggers the kiosk via full-screen notification intent.
        ============================================================ -->
        <receiver
            android:name=".adherence.AdherenceAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_ADHERENCE_ALARM" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Pairing Activity â€” first-launch QR scan to pair with partner
        ============================================================ -->
        <activity
            android:name=".pairing.PairingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ============================================================
             TpeFlutterActivity â€” Flutter UI host (replaces HandlerChatActivity
             and MainActivity as the primary user-facing entry-point).
             The Flutter engine renders all screens; native services are
             accessed via MethodChannels registered in TpeFlutterActivity.
        ============================================================ -->
        <activity
            android:name=".bridge.TpeFlutterActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect permission rationale screen (required by Health Connect) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             Handler Chat Activity â€” kept for backward compatibility with
             existing FCM deep-links; no longer the primary launcher.
        ============================================================ -->
        <activity
            android:name=".handler.HandlerChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             Main Activity â€” admin / device-settings screen (no LAUNCHER)
        ============================================================ -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- ============================================================
             Review Activity â€” "Start Review" screen for peer streaming
        ============================================================ -->
        <activity
            android:name=".review.ReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ============================================================
             ScreencastService â€” foreground service that captures the screen
             and feeds it into the WebRTC peer-review stream.
        ============================================================ -->
        <service
            android:name=".review.ScreencastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />

        <!-- ============================================================
             FilterService â€” foreground, started on boot, bound via AIDL
        ============================================================ -->
        <service
            android:name=".service.FilterService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="com.hound.controller.BIND_FILTER_SERVICE" />
            </intent-filter>
        </service>

        <!-- ============================================================
             Persistent MQTT command service
        ============================================================ -->
        <service
            android:name=".mqtt.PartnerMqttService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ============================================================
             Mindful Communication Module â€” Incoming filter
             Requires the user to grant Notification Access in Settings.
        ============================================================ -->
        <service
            android:name=".mindful.MindfulNotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ============================================================
             Mindful Communication Module â€” Outgoing / tone filter
             Requires the user to grant Accessibility access in Settings.
        ============================================================ -->
        <service
            android:name=".mindful.ToneEnforcementService"
            android:exported="false"
            android:label="@string/tone_enforcement_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tone_enforcement_service" />
        </service>

        <!-- ============================================================
             Xposed Tone Receiver â€” catches soft-mode infraction broadcasts
             fired by the Xposed InputConnectionHook (which runs inside
             third-party apps and must never make network calls directly).
             exported="true" is required because the sender lives in a
             different process; the broadcast is explicit (setPackage) so
             only this receiver can receive it.
        ============================================================ -->
        <receiver
            android:name=".mindful.XposedToneReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_XPOSED_TONE_INFRACTION" />
                <action android:name="com.hound.controller.ACTION_XPOSED_TONE_BLOCK" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Xposed Coverage Receiver â€” receives media-lane coverage events
             from LSPosed hooks running in third-party app processes and
             forwards them to the configured partner webhook.
        ============================================================ -->
        <receiver
            android:name=".telemetry.XposedCoverageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_XPOSED_COVERAGE_EVENT" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Capabilities Service â€” comprehensive AccessibilityService that
             acts as a fallback for the LSPosed module on non-rooted and
             lower-end devices.  Provides:
               â€¢ Screen-text reading for Tone Enforcement
               â€¢ Unauthorized app-launch blocking
               â€¢ Uninstall prevention
             Requires the user to grant Accessibility access in Settings.
        ============================================================ -->
        <service
            android:name=".capability.TpeCapabilityService"
            android:exported="false"
            android:label="@string/tpe_capability_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tpe_capability_service" />
        </service>

        <!-- ============================================================
             Vault Autofill Service â€” serves managed credentials via the
             Android Autofill Framework.  The user must select "TpeApp" as
             their system autofill provider in Settings â†’ Passwords &amp;
             accounts â†’ Autofill service (or equivalent for their launcher).
        ============================================================ -->
        <service
            android:name=".vault.VaultAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/vault_autofill_service" />
        </service>

        <!-- ============================================================
             Package Change Receiver â€” monitors app installs/uninstalls
             to keep the partner dashboard's app list current.
             ACTION_PACKAGE_ADDED and ACTION_PACKAGE_REMOVED are on the
             implicit-broadcast exempt list and may be received statically.
        ============================================================ -->
        <receiver
            android:name=".apps.PackageChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Boot receiver â€” restart FilterService after reboot
        ============================================================ -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Device Admin receiver
        ============================================================ -->
        <receiver
            android:name=".mdm.AppDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Task Assignment &amp; Verification Module
        ============================================================ -->

        <!-- TaskDeadlineReceiver â€” fires when an assigned task deadline passes -->
        <receiver
            android:name=".tasks.TaskDeadlineReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_TASK_DEADLINE" />
            </intent-filter>
        </receiver>

        <!-- TaskVerificationActivity â€” lets the device owner submit photo proof -->
        <activity
            android:name=".tasks.TaskVerificationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- TaskListActivity â€” shows pending and completed tasks -->
        <activity
            android:name=".tasks.TaskListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- AssignTaskActivity â€” partner-side: compose and send a task -->
        <activity
            android:name=".tasks.AssignTaskActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ============================================================
             Daily Check-In Activity â€” device owner submits mood + note
             Can be opened from MainActivity or a REQUEST_CHECKIN FCM notification.
        ============================================================ -->
        <activity
            android:name=".checkin.CheckInActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ============================================================
             Puppy Pouch â€” Anonymous Questions Module
             Partner-side: view and answer anonymous questions.
             PIN-protected via MainActivity before launch.
        ============================================================ -->
        <activity
            android:name=".questions.QuestionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ============================================================
             Overlay Activity â€” full-screen partner message / URL launcher
             displayed over the lock screen via full-screen intent pattern.
        ============================================================ -->
        <activity
            android:name=".device.OverlayActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tpeapp" />

        <!-- ================================================================
             Submission-deepening features
        ================================================================ -->

        <!-- Ritual Module -->
        <activity
            android:name=".ritual.RitualChecklistActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tpeapp" />
        <receiver
            android:name=".ritual.RitualAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_RITUAL_MORNING" />
                <action android:name="com.hound.controller.ACTION_RITUAL_EVENING" />
            </intent-filter>
        </receiver>

        <!-- Corner Time -->
        <activity
            android:name=".consequence.CornerTimeActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tpeapp" />
        <receiver
            android:name=".consequence.ConsequenceEscalationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_CONSEQUENCE_ESCALATE" />
            </intent-filter>
        </receiver>

        <!-- Affirmation Module -->
        <activity
            android:name=".affirmation.AffirmationActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tpeapp" />
        <receiver
            android:name=".affirmation.MantraAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_MANTRA_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Lovense Schedules -->
        <receiver
            android:name=".ble.LovenseScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hound.controller.ACTION_LOVENSE_SCHEDULED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Location Tracking Service â€” foreground service that periodically
             samples GPS coordinates and reports them to the FastAPI backend.
             Started explicitly by BootReceiver / FCM command; must declare
             foregroundServiceType="location" for Android 10+ background
             location access.
        ============================================================ -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!-- ============================================================
             Battery Monitor Receiver â€” listens for ACTION_BATTERY_CHANGED
             and triggers consequences when battery drops below thresholds.
             ACTION_BATTERY_CHANGED is a sticky broadcast that must be
             registered dynamically at runtime; this entry exists for
             tooling / manifest documentation purposes.
        ============================================================ -->
        <receiver
            android:name=".battery.BatteryMonitorReceiver"
            android:exported="false" />

    </application>

</manifest>

